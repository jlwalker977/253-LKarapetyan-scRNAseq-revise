DimPlot(dat_ot_cd3, reduction = "harmony", label=TRUE, repel=TRUE, group.by = c("seurat_clusters", "cell_types2"))
FeaturePlot(dat_ot_cd3, features = c("IGLV2-14"), reduction="harmony")
dat_ot_cd4 = NormalizeData(dat_ot_cd4)
dat_ot_cd4 = ScaleData(dat_ot_cd4)
dat_ot_cd4 <- FindVariableFeatures(dat_ot_cd4)
dat_ot_cd4 = ScaleData(dat_ot_cd4)
dat_ot_cd4 <- RunPCA(dat_ot_cd4, npcs = 30, verbose = FALSE)
(identical(rownames(Embeddings(dat_ot_cd4, "pca")), colnames(dat_ot_cd4)))
sample_sizes <- sort(table(dat_ot_cd4$Patient.Number))
print(sample_sizes)
cat("Min cells:", min(sample_sizes), "\n")
cat("PCA dims used:", 10, "\n")
cat("Rule of thumb: need > dims*2 cells per sample\n")
# Verify PCA dims actually computed (some small samples may have fewer PCs)
pca_embed <- Embeddings(dat_ot_cd4, "pca")
cat("PCA dimensions available:", ncol(pca_embed), "\n")
cat("Cells in PCA:", nrow(pca_embed), "\n")
library(harmony)
dat_ot_cd4 <- IntegrateLayers(
object         = dat_ot_cd4,
method         = HarmonyIntegration,
orig.reduction = "pca",
new.reduction  = "harmony",
grouping.var   = "Patient.Number",
verbose        = TRUE
)
# Use harmony reduction downstream
dat_ot_cd4[["RNA"]] <- JoinLayers(dat_ot_cd4[["RNA"]])
dat_ot_cd4 <- FindNeighbors(dat_ot_cd4, reduction = "harmony", dims = 1:30)
dat_ot_cd4 <- FindClusters(dat_ot_cd4, resolution = 0.25, algorithm = 4, random.seed = 1)
qsave(dat_ot_cd4, file = "dat-til-post-int-cd4-only-harmony-050526.qs")
VlnPlot(dat_ot_cd4, features = c("IGLV2-14"))
DimPlot(dat_ot_cd4, reduction = "harmony", label=TRUE, repel=TRUE, group.by = c("seurat_clusters"))
FeaturePlot(dat_ot_cd4, features = c("IGLV2-14"), reduction="harmony")
savehistory("/ix/rbao/Projects/HCC-CBS-253-Hillman-LKarapetyan-scRNAseq-revise/results/jwork/050526-reint-by-cell-types-duh-some-checks.Rhistory")
