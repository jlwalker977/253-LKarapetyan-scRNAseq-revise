library(qs)
library(Seurat)
library(future)
options(future.globals.maxSize = 100 * 1024^3)
# --- 1. Load with validation ---
cat("Loading seu object...\n")
dat_t <- tryCatch(
dat_ot_mac,
error = function(e) { cat("ERROR reading file:", conditionMessage(e), "\n"); NULL }
)
if (is.null(dat_t)) stop("dat_t is NULL after qread — check file path and integrity.")
if (!inherits(dat_t, "Seurat")) stop(paste("Object is not a Seurat object; class is:", class(dat_t)))
cat("Object loaded. Class:", class(dat_t), "\n")
cat("Assays:", paste(Assays(dat_t), collapse = ", "), "\n")
cat("Layers:", paste(Layers(dat_t), collapse = ", "), "\n")
cat("Reductions:", paste(Reductions(dat_t), collapse = ", "), "\n")
# --- 2. Verify PCA exists before integration ---
if (!"pca" %in% Reductions(dat_t)) stop("'pca' reduction not found. Run ScaleData + RunPCA first.")
# --- 3. Check layer structure (Seurat v5 split layers required for integration) ---
rna_layers <- Layers(dat_t[["RNA"]])
cat("RNA layers:", paste(rna_layers, collapse = ", "), "\n")
if (!any(grepl("^counts\\.", rna_layers) | grepl("^data\\.", rna_layers))) {
cat("WARNING: Layers may not be split by sample. Integration requires split layers.\n")
cat("If needed, run: dat_t[['RNA']] <- split(dat_t[['RNA']], f = dat_t$orig.ident)\n")
}
# --- 4. Integration ---
cat("Starting RPCA integration...\n")
dat_t <- tryCatch(
IntegrateLayers(
object      = dat_t,
method      = RPCAIntegration,
orig.reduction = "pca",
new.reduction  = "integrated.rpca",
verbose     = TRUE,      # set TRUE to catch where it breaks
dims        = 1:10,
k.weight    = 80
),
error = function(e) { cat("ERROR during IntegrateLayers:", conditionMessage(e), "\n"); NULL }
)
if (is.null(dat_t)) stop("Integration returned NULL.")
# Run these checks BEFORE IntegrateLayers
cat("Seurat version:", as.character(packageVersion("Seurat")), "\n")
cat("SeuratObject version:", as.character(packageVersion("SeuratObject")), "\n")
# Check layer names — must be split like "data.sample1", "data.sample2"
cat("Layers:\n")
print(Layers(dat_t[["RNA"]]))
dat_t
dat_t = dat_ot_mac
