#  error = function(e) { cat("ERROR reading file:", conditionMessage(e), "\n"); NULL }
#)
if (is.null(dat_ot_mac)) stop("dat_t is NULL after qread — check file path and integrity.")
if (!inherits(dat_ot_mac, "Seurat")) stop(paste("Object is not a Seurat object; class is:", class(dat_ot_mac)))
cat("Object loaded. Class:", class(dat_ot_mac), "\n")
cat("Assays:", paste(Assays(dat_ot_mac), collapse = ", "), "\n")
cat("Layers:", paste(Layers(dat_ot_mac), collapse = ", "), "\n")
cat("Reductions:", paste(Reductions(dat_ot_mac), collapse = ", "), "\n")
# --- 2. Verify PCA exists before integration ---
if (!"pca" %in% Reductions(dat_ot_mac)) stop("'pca' reduction not found. Run ScaleData + RunPCA first.")
# --- 3. Check layer structure (Seurat v5 split layers required for integration) ---
rna_layers <- Layers(dat_ot_mac[["RNA"]])
cat("RNA layers:", paste(rna_layers, collapse = ", "), "\n")
if (!any(grepl("^counts\\.", rna_layers) | grepl("^data\\.", rna_layers))) {
cat("WARNING: Layers may not be split by sample. Integration requires split layers.\n")
cat("If needed, run: dat_t[['RNA']] <- split(dat_t[['RNA']], f = dat_t$orig.ident)\n")
}
# --- 4. Integration ---
cat("Starting RPCA integration...\n")
dat_ot_mac <- tryCatch(
IntegrateLayers(
object      = dat_ot_mac,
method      = RPCAIntegration,
orig.reduction = "pca",
new.reduction  = "integrated.rpca",
verbose     = TRUE,      # set TRUE to catch where it breaks
dims        = 1:10,
k.weight    = 80
),
error = function(e) { cat("ERROR during IntegrateLayers:", conditionMessage(e), "\n"); NULL }
)
if (is.null(dat_ot_mac)) stop("Integration returned NULL.")
dat_ot_mac
options(future.globals.maxSize = 100 * 1024^3)
